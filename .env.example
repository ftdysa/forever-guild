# at least 16 characters; a few random words works well
GUILD_PASSPHRASE=
# at least 32 characters; generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
PORT=3000
DB_PATH=./data/roster.db
# set true when served over HTTPS
COOKIE_SECURE=false
# set true when behind a single reverse proxy (trusts one X-Forwarded-For hop)
TRUST_PROXY=false
# header your edge proxy sets to the real client IP, e.g. fly-client-ip; leave
# empty unless all traffic is guaranteed to pass through that proxy
CLIENT_IP_HEADER=

# Optional Blizzard armory (guild import + gear view). Leave the id/secret empty to
# disable. Create a client at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# us | eu | kr | tw
BLIZZARD_REGION=us
# classic1x (Classic Era / Anniversary) | classic (progression) | retail
BLIZZARD_NAMESPACE=classic1x
# realm and guild slugs as in armory URLs: lowercase, spaces become hyphens
BLIZZARD_REALM=
BLIZZARD_GUILD=
